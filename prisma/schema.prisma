generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskFrequency {
  ONE_OFF
  DAILY
  WEEKLY
  MONTHLY
}

enum TaskContext {
  HOME
  OUT
  COMPUTER
}

enum TaskType {
  CHORE
  REPAIR
  BUSINESS
  HEALTH
  SOCIAL
  ADMIN
}

enum TaskEnergy {
  LOW
  MEDIUM
  HIGH
}

enum IntentMode {
  CHILL
  NORMAL
  GRIND
}

enum PickAction {
  PICKED
  STARTED
  DONE
  SKIPPED
}

enum SkippedReason {
  TOO_HARD
  NO_TIME
  NOT_TODAY
  BLOCKED
  OTHER
}

enum AiStepsGenerationStatus {
  PENDING
  READY
  FAILED
  SKIPPED
}

enum AiProvider {
  OPENAI
  LOCAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  tasks        Task[]
  intents      DailyIntent[]
  pickEvents   PickEvent[]
  aiStarterStepRequests AiStarterStepRequest[]
  passwordResetTokens PasswordResetToken[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BootstrapProbe {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  frequency           TaskFrequency @default(ONE_OFF)
  context             TaskContext
  type                TaskType
  energy              TaskEnergy
  timeEstimateMinutes Int
  avoiding            Boolean       @default(false)
  starterStep         String
  checklistItems      Json
  tips                Json
  generateAiStepsEnabled Boolean @default(false)
  aiProvider          AiProvider @default(OPENAI)
  aiStepsGenerationStatus AiStepsGenerationStatus @default(SKIPPED)
  aiGeneratedSteps    Json?
  aiGeneratedAt       DateTime?
  aiStarterStepRequests AiStarterStepRequest[]
  isArchived          Boolean       @default(false)
  pickEvents          PickEvent[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([userId, isArchived])
  @@index([userId, context, energy])
}

model DailyIntent {
  id                   String      @id @default(cuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextChoice        TaskContext
  modeChoice           IntentMode
  timeAvailableMinutes Int
  pickEvents           PickEvent[]
  createdAt            DateTime    @default(now())

  @@index([userId, createdAt])
}

model PickEvent {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId        String
  task          Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  intentId      String?
  intent        DailyIntent?  @relation(fields: [intentId], references: [id], onDelete: SetNull)
  pickedAt      DateTime      @default(now())
  action        PickAction
  skippedReason SkippedReason?
  notes         String?
  why           String

  @@index([userId, pickedAt])
  @@index([taskId, pickedAt])
  @@index([intentId])
}

model AiStarterStepRequest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  titleSnapshot   String
  generatedStep   String
  promptTokens    Int?
  completionTokens Int?
  createdAt       DateTime @default(now())

  @@unique([userId, taskId])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}
